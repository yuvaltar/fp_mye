{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yuvaltar/fp_mye/contracts/prediction.schema.json",
  "title": "Temporal Skills Market API contract",
  "description": "Contract between /algo (serves the API) and /web (consumes it). The root of this schema is the response of GET /predict; the other responses live in $defs. All volatilities are annualized 5-trading-day realized volatility expressed as a decimal (0.24 means 24%): sqrt(252/5 * sum of the 5 squared daily log returns). This file only changes with the agreement of both teams.",
  "x-endpoints": {
    "GET /predict?ticker=XXX": { "200": "#/$defs/Prediction", "404": "#/$defs/Error" },
    "GET /tickers": { "200": "#/$defs/TickersResponse" },
    "GET /history?ticker=XXX": { "200": "#/$defs/HistoryResponse", "404": "#/$defs/Error" },
    "GET /overview": { "200": "#/$defs/OverviewResponse" },
    "GET /weights?ticker=XXX": { "200": "#/$defs/WeightsHistoryResponse", "404": "#/$defs/Error" },
    "GET /performance": { "200": "#/$defs/PerformanceResponse" }
  },
  "$ref": "#/$defs/Prediction",
  "$defs": {
    "Ticker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,9}$",
      "description": "Upper-case stock symbol as used by Yahoo Finance, e.g. AAPL."
    },
    "Volatility": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Annualized 5-trading-day realized volatility, as a decimal."
    },
    "SkillPrediction": {
      "type": "object",
      "description": "What one skill (agent) predicted and how much the supervisor trusted it.",
      "additionalProperties": false,
      "required": ["name", "horizon", "weight", "predicted_vol"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable snake_case identifier of the skill, e.g. short_trend."
        },
        "horizon": {
          "enum": ["short", "medium", "long"],
          "description": "Time scale the skill specializes in: short = about 1-5 trading days of history, medium = about 5-22, long = more than 22."
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Weight assigned by the supervisor. The weights of all skills in one prediction sum to 1."
        },
        "predicted_vol": { "$ref": "#/$defs/Volatility" }
      }
    },
    "Prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "as_of_date",
        "horizon_days",
        "predicted_vol",
        "baseline_vol",
        "skills",
        "supervisor_confidence",
        "model_version"
      ],
      "properties": {
        "ticker": { "$ref": "#/$defs/Ticker" },
        "as_of_date": {
          "type": "string",
          "format": "date",
          "description": "Last trading day whose closing price was used (YYYY-MM-DD). The prediction covers the 5 trading days after it."
        },
        "horizon_days": {
          "const": 5,
          "description": "Number of trading days the prediction covers. Fixed to 5 for the MVP."
        },
        "predicted_vol": {
          "$ref": "#/$defs/Volatility",
          "description": "Final prediction of the supervisor (the market)."
        },
        "baseline_vol": {
          "$ref": "#/$defs/Volatility",
          "description": "Prediction of the HAR-RV baseline for the same ticker, date and horizon."
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SkillPrediction" }
        },
        "supervisor_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How confident the supervisor is in predicted_vol, from 0 (none) to 1 (full)."
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "description": "Version of the engine that produced the prediction, e.g. 0.1.0."
        },
        "earnings_date": { "$ref": "#/$defs/EarningsDate" }
      }
    },
    "EarningsDate": {
      "anyOf": [{ "type": "string", "format": "date" }, { "type": "null" }],
      "description": "Date of the company's quarterly earnings report when it falls in the 5 trading days the prediction covers (YYYY-MM-DD), otherwise null. Optional: absent means the engine does not report it. It explains why a prediction jumps in that week."
    },
    "TickersResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tickers"],
      "properties": {
        "tickers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ticker", "name"],
            "properties": {
              "ticker": { "$ref": "#/$defs/Ticker" },
              "name": { "type": "string", "minLength": 1, "description": "Company name for display." },
              "sector": {
                "type": "string",
                "minLength": 1,
                "description": "Optional GICS sector, e.g. Information Technology. The website shows a sector filter when sectors are present."
              }
            }
          }
        }
      }
    },
    "HistoryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of_date", "predicted_vol", "baseline_vol", "realized_vol"],
      "properties": {
        "as_of_date": { "type": "string", "format": "date" },
        "predicted_vol": { "$ref": "#/$defs/Volatility" },
        "baseline_vol": { "$ref": "#/$defs/Volatility" },
        "realized_vol": {
          "anyOf": [{ "$ref": "#/$defs/Volatility" }, { "type": "null" }],
          "description": "Volatility actually observed over the 5 trading days after as_of_date. null while those 5 days have not all passed yet."
        }
      }
    },
    "HistoryResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ticker", "horizon_days", "points"],
      "properties": {
        "ticker": { "$ref": "#/$defs/Ticker" },
        "horizon_days": { "const": 5 },
        "points": {
          "type": "array",
          "description": "Past predictions, oldest first, one per as_of_date.",
          "items": { "$ref": "#/$defs/HistoryPoint" }
        }
      }
    },
    "OverviewEntry": {
      "type": "object",
      "description": "The few numbers the watchlist needs for one ticker, so a list of about 50 tickers takes one request instead of two per ticker.",
      "additionalProperties": false,
      "required": [
        "ticker",
        "as_of_date",
        "predicted_vol",
        "baseline_vol",
        "supervisor_confidence",
        "latest_realized_vol"
      ],
      "properties": {
        "ticker": { "$ref": "#/$defs/Ticker" },
        "as_of_date": { "type": "string", "format": "date" },
        "predicted_vol": { "$ref": "#/$defs/Volatility" },
        "baseline_vol": { "$ref": "#/$defs/Volatility" },
        "supervisor_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "latest_realized_vol": {
          "anyOf": [{ "$ref": "#/$defs/Volatility" }, { "type": "null" }],
          "description": "The latest realized_vol that is not null in that ticker's /history, or null. The website compares the prediction with it to show the volatility trend."
        },
        "earnings_date": { "$ref": "#/$defs/EarningsDate" }
      }
    },
    "OverviewResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": {
        "entries": {
          "type": "array",
          "description": "One entry per ticker that has a prediction; a ticker without one is simply absent.",
          "items": { "$ref": "#/$defs/OverviewEntry" }
        }
      }
    },
    "SkillRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "horizon"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "horizon": { "enum": ["short", "medium", "long"] }
      }
    },
    "WeightsPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["as_of_date", "weights"],
      "properties": {
        "as_of_date": { "type": "string", "format": "date" },
        "weights": {
          "type": "array",
          "minItems": 1,
          "description": "Weight of every skill on that date. They sum to 1.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "weight"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "WeightsHistoryResponse": {
      "type": "object",
      "description": "How the supervisor's weights moved over time. Same dates as /history (oldest first); the last point equals the weights in /predict.",
      "additionalProperties": false,
      "required": ["ticker", "skills", "points"],
      "properties": {
        "ticker": { "$ref": "#/$defs/Ticker" },
        "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/SkillRef" } },
        "points": { "type": "array", "items": { "$ref": "#/$defs/WeightsPoint" } }
      }
    },
    "ModelPerformance": {
      "type": "object",
      "description": "Backtest scores of one model. The *_vs_har_rv fields are the improvement over the HAR-RV baseline as a decimal (0.109 means 10.9% lower error), null on the baseline's own row.",
      "additionalProperties": false,
      "required": ["name", "kind", "rmse", "mae", "qlike", "rmse_vs_har_rv", "mae_vs_har_rv", "qlike_vs_har_rv"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "kind": { "enum": ["supervisor", "skill", "baseline"] },
        "rmse": { "type": "number", "minimum": 0 },
        "mae": { "type": "number", "minimum": 0 },
        "qlike": { "type": "number", "minimum": 0 },
        "rmse_vs_har_rv": { "type": ["number", "null"] },
        "mae_vs_har_rv": { "type": ["number", "null"] },
        "qlike_vs_har_rv": { "type": ["number", "null"] }
      }
    },
    "PerformanceResponse": {
      "type": "object",
      "description": "Summary of the walk-forward backtest, the same numbers as docs/backtest.md. QLIKE is the headline metric.",
      "additionalProperties": false,
      "required": [
        "generated_at",
        "model_version",
        "period_start",
        "period_end",
        "evaluation_dates",
        "scored_predictions",
        "tickers",
        "headline",
        "models",
        "skill_weights",
        "per_ticker"
      ],
      "properties": {
        "generated_at": { "type": "string", "format": "date" },
        "model_version": { "type": "string", "minLength": 1 },
        "period_start": { "type": "string", "format": "date" },
        "period_end": { "type": "string", "format": "date" },
        "evaluation_dates": { "type": "integer", "minimum": 1 },
        "scored_predictions": { "type": "integer", "minimum": 1 },
        "tickers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Ticker" } },
        "headline": {
          "type": "object",
          "description": "The one-line result: the supervisor against HAR-RV on QLIKE.",
          "additionalProperties": false,
          "required": ["metric", "supervisor", "baseline", "improvement", "tickers_better", "tickers_total", "t_statistic"],
          "properties": {
            "metric": { "const": "qlike" },
            "supervisor": { "type": "number", "minimum": 0 },
            "baseline": { "type": "number", "minimum": 0 },
            "improvement": { "type": "number", "description": "1 - supervisor / baseline, a decimal." },
            "tickers_better": { "type": "integer", "minimum": 0 },
            "tickers_total": { "type": "integer", "minimum": 1 },
            "t_statistic": { "type": "number", "description": "Corrected for overlapping evaluation dates; about 2 or more is the usual bar." }
          }
        },
        "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ModelPerformance" } },
        "skill_weights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "horizon", "mean", "min", "max"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "horizon": { "enum": ["short", "medium", "long"] },
              "mean": { "type": "number", "minimum": 0, "maximum": 1 },
              "min": { "type": "number", "minimum": 0, "maximum": 1 },
              "max": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "per_ticker": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ticker", "supervisor_qlike", "baseline_qlike"],
            "properties": {
              "ticker": { "$ref": "#/$defs/Ticker" },
              "supervisor_qlike": { "type": "number", "minimum": 0 },
              "baseline_qlike": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "Error": {
      "type": "object",
      "description": "Body of a non-200 response (FastAPI's default shape), e.g. 404 for an unknown ticker.",
      "required": ["detail"],
      "properties": {
        "detail": { "type": "string" }
      }
    }
  }
}
