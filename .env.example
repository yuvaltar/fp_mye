# Copy to .env (never committed) and adjust. No API keys are needed for the MVP:
# market data comes from yfinance, which is keyless.

# --- algo (FastAPI) ---
ALGO_API_HOST=127.0.0.1
ALGO_API_PORT=8000
# Origin of the website allowed to call the API (CORS)
ALGO_CORS_ORIGIN=http://localhost:3000
# SEC EDGAR asks every automated client for a name and a contact email in its User-Agent.
# Needed only by python -m tsm.earnings, e.g. "Temporal Skills Market your.name@example.com".
SEC_USER_AGENT=

# --- web (Next.js) ---
# Base URL of the algo API
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# true = serve /contracts mock files instead of calling the API
NEXT_PUBLIC_USE_MOCKS=true
# true = show real, delayed (up to ~15 min) stock prices from Yahoo Finance's
# public endpoints (no key). Optional, off by default; the site works without it.
NEXT_PUBLIC_LIVE_MARKET_DATA=false

# --- web: AI assistant (optional; the site works without it) ---
# Server-side only: never prefix with NEXT_PUBLIC_ and never commit a real key.
# Get a free key in Google AI Studio (aistudio.google.com), then put it in web/.env.local.
GEMINI_API_KEY=
# Optional. The default is a light model from Google's current list; see ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=
# Set to false to switch the assistant off even when a key is present
ASSISTANT_ENABLED=true
# MCP server at /api/mcp: required in production; without it the endpoint answers only on localhost.
MCP_AUTH_TOKEN=
